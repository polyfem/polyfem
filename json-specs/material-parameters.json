[
    {
        "pointer": "/type",
        "type": "string",
        "options": [
            "Stokes",
            "NavierStokes",
            "NavierStokesFSI",
            "OperatorSplitting",
            "Electrostatics",
            "IncompressibleLinearElasticity",
            "Laplacian",
            "Helmholtz",
