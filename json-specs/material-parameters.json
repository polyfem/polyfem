        "required": [
            "type",
            "viscosity",
            "velocity_space_id",
            "pressure_space_id"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, viscosity, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "NavierStokes",
        "required": [
            "type",
            "viscosity",
            "velocity_space_id",
            "pressure_space_id"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, viscosity, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "NavierStokesFSI",
        "required": [
            "type",
            "viscosity",
            "velocity_space_id",
            "pressure_space_id",
            "mesh_displacement_space_id",
            "mesh_material"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "ALE Navier-Stokes material with a nested elastic material for mesh displacement."
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "NavierStokesFSI",
        "required": [
            "type",
            "viscosity",
            "velocity_space_id",
            "pressure_space_id",
            "mesh_displacement_space_id",
            "mesh_material",
            "fluid_geometry_id",
            "solid_geometry_id",
            "displacement_space_id",
            "solid_material"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Two-mesh ALE Navier-Stokes material with an independently assembled physical solid."
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "OperatorSplitting",
        "required": [
            "type",
            "viscosity",
            "velocity_space_id",
            "pressure_space_id"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, viscosity, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "Electrostatics",
        "required": [
            "type",
            "epsilon"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "IncompressibleLinearElasticity",
        "required": [
            "type",
            "E",
            "nu",
            "displacement_space_id",
            "pressure_space_id"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, Young's modulus ($E$), Poisson's ratio ($\\nu$), density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "IncompressibleLinearElasticity",
        "required": [
            "type",
            "lambda",
            "mu",
            "displacement_space_id",
            "pressure_space_id"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, Lamé first ($\\lambda$), Lamé second ($\\mu$), density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "Laplacian",
        "required": [
            "type"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "Helmholtz",
        "required": [
            "type",
            "k"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, k, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "Bilaplacian",
        "required": [
            "type",
            "solution_space_id",
            "auxiliary_space_id"
        ],
        "optional": [
            "id",
            "rho"
        ],
        "doc": "Material Parameters including ID, density ($\\rho$)"
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "ThermoElasticity",
        "required": [
            "type",
            "displacement_space_id",
            "temperature_space_id",
            "elastic_material",
            "alpha",
            "T0"
        ],
        "optional": [
            "id",
            "rho",
            "heat_capacity",
            "conductivity"
        ],
        "doc": "Thermoelastic mixed material. The displacement block currently reuses the nested elastic_material and the temperature block uses a scalar Laplacian."
    },
    {
        "pointer": "/",
        "type": "object",
        "type_name": "GrowthElasticity",
        "required": [
            "type", 
            "displacement_space_id", 
            "growth_space_id", 
            "elastic_material", 
            "normal_direction"
        ],
        "optional": [
            "id", 
            "rho", 
            "normal_growth"
        ],
        "doc": "Growth mixed material: additive correction J^g psi(Fe) - psi(F) on a (displacement, growth) block pair. The displacement block reuses the nested elastic_material; the growth field theta is the second space's scalar DOF. normal_direction is the reference wall normal (constant or per-element file); normal_growth is the prescribed normal component (default 1)."
    },
    {
        "pointer": "/viscosity",
        "type": "include",
        "spec_file": "value-no.json",
        "doc": "Fuild's viscosity"
    },
    {
        "pointer": "/velocity_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for the fluid velocity"
    },
    {
        "pointer": "/pressure_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for pressure"
    },
    {
        "pointer": "/displacement_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for displacement"
    },
    {
        "pointer": "/mesh_displacement_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for ALE mesh displacement"
    },
    {
        "pointer": "/mesh_material",
        "type": "include",
        "spec_file": "elastic-material-parameters.json",
        "doc": "Elastic material used to extend boundary motion into the fluid mesh"
    },
    {
        "pointer": "/solid_material",
        "type": "include",
        "spec_file": "elastic-material-parameters.json",
        "doc": "Elastic material used by the independently assembled physical solid"
    },
    {
        "pointer": "/fluid_geometry_id",
        "type": "int",
        "min": 0,
        "doc": "Geometry ID containing the fluid mesh"
    },
    {
        "pointer": "/solid_geometry_id",
        "type": "int",
        "min": 0,
        "doc": "Geometry ID containing the physical solid mesh"
    },
    {
        "pointer": "/temperature_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for temperature"
    },
    {
        "pointer": "/growth_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for the scalar growth field"
    },
    {
        "pointer": "/alpha",
        "type": "include",
        "spec_file": "value-no.json",
        "doc": "Thermal expansion coefficient"
    },
    {
        "pointer": "/T0",
        "type": "include",
        "spec_file": "value-no.json",
        "doc": "Reference temperature"
    },
    {
        "pointer": "/heat_capacity",
        "type": "include",
        "spec_file": "value1.json",
        "default": 1,
        "doc": "Specific heat capacity used by the temperature block"
    },
    {
        "pointer": "/conductivity",
        "type": "include",
        "spec_file": "value1.json",
        "default": 1,
        "doc": "Thermal conductivity used by the temperature block"
    },
    {
        "pointer": "/elastic_material",
        "type": "include",
        "spec_file": "elastic-material-parameters.json",
        "doc": "Elastic material object used by the displacement block."
    },
    {
        "pointer": "/solution_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for the primary solution"
    },
    {
        "pointer": "/auxiliary_space_id",
        "type": "int",
        "min": 0,
        "doc": "FE space ID for the auxiliary solution"
    },
    {
        "pointer": "/epsilon",
        "type": "include",
        "spec_file": "value-no.json",
        "doc": "permittivity"
    },
    {
        "pointer": "/normal_direction",
        "type": "list",
        "doc": "Reference wall normal n0 as a constant [x, y, z] (normalized on load)."
    },
    {
        "pointer": "/normal_direction/*",
        "type": "include",
        "spec_file": "value0.json",
        "doc": "Entries of the constant wall normal",
        "default": 0
    },
    {
        "pointer": "/normal_direction",
        "type": "object",
        "required": [
            "type",
            "path"
        ],
        "optional": [
            "field"
        ],
        "doc": "Per-element wall normal read from a file, bound by global element id"
    },
    {
        "pointer": "/normal_direction/type",
        "type": "string",
        "options": [
            "per_element_file"
        ],
        "doc": "Wall normal source"
    },
    {
        "pointer": "/normal_direction/path",
        "type": "string",
        "doc": "Path to a legacy ASCII VTK file, resolved relative to the input JSON"
    },
    {
        "pointer": "/normal_direction/field",
        "type": "string",
        "default": "N0",
        "doc": "Name of the CELL_DATA array holding the per-element wall normals"
    },
    {
        "pointer": "/normal_growth",
        "type": "float",
        "default": 1,
        "doc": "Prescribed normal growth component vn (default 1: pure in-plane growth). The amended-map thickness field, when adopted, is supplied here per element."
    },
    {
        "pointer": "/normal_growth",
        "type": "object",
        "required": [
            "type",
            "path"
        ],
        "optional": [
            "field"
        ],
        "doc": "Per-element normal growth read from a file, bound by global element id"
    },
    {
        "pointer": "/normal_growth/type",
        "type": "string",
        "options": [
            "per_element_file"
        ],
        "doc": "Normal growth source"
    },
    {
        "pointer": "/normal_growth/path",
        "type": "string",
        "doc": "Path to a legacy ASCII VTK file, resolved relative to the input JSON"
    },
    {
        "pointer": "/normal_growth/field",
        "type": "string",
        "default": "VN",
        "doc": "Name of the CELL_DATA array holding the per-element normal growth"
    }

]
