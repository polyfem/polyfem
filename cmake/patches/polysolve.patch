 namespace polysolve::nonlinear::line_search
 {
+    namespace
+    {
+        template <typename T>
+std::ostream& operator<<(std::ostream& os, const std::vector<T>& v) {
+            for (const auto& i : v) os << i << " ";
+            return os;
+        }
+
+        void plot_over_descent_direction(
+            Problem& objFunc,
+            const Eigen::VectorXd& x,
+            const Eigen::VectorXd& dx,
+            double max_step_size = 1)
+        {
+            double alpha = 1e-20;
+            std::vector<double> alphas, values, linearApprox;
+            objFunc.solution_changed(x);
+            alphas.push_back(0);
+            values.push_back(objFunc.value(x));
+            linearApprox.push_back(objFunc.value(x));
+            Eigen::VectorXd grad;
+            objFunc.gradient(x, grad);
+            while (alpha < max_step_size)
+            {
+                Eigen::VectorXd y = x + dx * alpha;
+                objFunc.solution_changed(y);
+
+                alphas.push_back(alpha);
+                values.push_back(objFunc.value(y));
+                linearApprox.push_back(values[0] + grad.dot(dx) * alpha);
+
+                alpha *= 1.5;
+            }
+
+            objFunc.solution_changed(x);
+
+            std::cout << std::setprecision(20) << std::fixed << "x = txt_to_array(\"" << x.transpose() << "\")\n";
+            std::cout << std::setprecision(20) << std::fixed << "g = txt_to_array(\"" << grad.transpose() << "\")\n";
+            std::cout << std::setprecision(20) << std::fixed << "dx = txt_to_array(\"" << dx.transpose() << "\")\n";
+            std::cout << std::setprecision(20) << std::fixed << "a = txt_to_array(\"" << alphas << "\")\n";
+            std::cout << std::setprecision(20) << std::fixed << "y = txt_to_array(\"" << values << "\")\n";
+            std::cout << std::setprecision(20) << std::fixed << "approx = txt_to_array(\"" << linearApprox << "\")\n";
+        }
+    }
