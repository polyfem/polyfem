 #endif
 
 #include <cfenv>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
 
 namespace polysolve::nonlinear::line_search
 {
+    namespace
+    {
+        template <typename T>
+std::ostream& operator<<(std::ostream& os, const std::vector<T>& v) {
+            for (const auto& i : v) os << i << " ";
+            return os;
+        }
+
+        void plot_over_descent_direction(
+            Problem& objFunc,
+            const Eigen::VectorXd& x,
+            const Eigen::VectorXd& dx,
+            const std::vector<double>& tried_alphas,
+            const std::string& stop_reason,
+            double max_step_size = 1)
+        {
+            static bool written = false;
+            if (written) return;
+            written = true;
+
+            double alpha = 1e-20;
+            std::vector<double> alphas, values, grad_norms;
+            Eigen::VectorXd grad;
+
+            objFunc.solution_changed(x);
+            alphas.push_back(0);
+            values.push_back(objFunc.value(x));
+            objFunc.gradient(x, grad);
+            grad_norms.push_back(grad.norm());
+
+            while (alpha < max_step_size)
+            {
+                Eigen::VectorXd y = x + dx * alpha;
+                objFunc.solution_changed(y);
+
+                alphas.push_back(alpha);
+                values.push_back(objFunc.value(y));
+                objFunc.gradient(y, grad);
+                grad_norms.push_back(grad.norm());
+
+                alpha *= 1.1;
+            }
+
+            {
+                Eigen::VectorXd y = x + dx * max_step_size;
+                objFunc.solution_changed(y);
+
+                alphas.push_back(max_step_size);
+                values.push_back(objFunc.value(y));
+                objFunc.gradient(y, grad);
+                grad_norms.push_back(grad.norm());
+            }
+
+            objFunc.solution_changed(x);
+            {
+                std::ofstream csv("line_search_profile.csv");
+                csv << std::setprecision(20) << std::fixed;
+                csv << "alpha,energy,grad_norm\n";
+                for (size_t i = 0; i < alphas.size(); ++i)
+                    csv << alphas[i] << "," << values[i] << "," << grad_norms[i] << "\n";
+            }
+            {
+                std::ofstream csv("line_search_tried_alphas.csv");
+                csv << std::setprecision(20) << std::fixed;
+                csv << "# stop_reason: " << stop_reason << "\n";
+                csv << "alpha\n";
+                for (double a : tried_alphas)
+                    csv << a << "\n";
+            }
+        }
+    }
