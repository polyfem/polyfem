-option(TIGHT_CORE_MATH "Enable coremath-based transcendental functions" ON)
+# core-math-cpp is GNU C: it uses __attribute__((cold)) and __int128, neither of
+# which MSVC supports, so it cannot build there at all. Default the option off
+# on MSVC rather than let the build fail in a dependency's sources.
+if(MSVC)
+	option(TIGHT_CORE_MATH "Enable coremath-based transcendental functions" OFF)
+else()
+	option(TIGHT_CORE_MATH "Enable coremath-based transcendental functions" ON)
+endif()
 
