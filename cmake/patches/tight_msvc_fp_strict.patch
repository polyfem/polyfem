--- a/cmake/recipes/nfg.cmake	2026-09-18 14:27:26
+++ b/cmake/recipes/nfg.cmake	2026-09-18 14:27:39
@@ -18,6 +18,23 @@
 # SIMD flags — compiler-predefined macros (__AVX2__, __SSE2__, __ARM_NEON)
 # are what NFG's header uses for feature detection, so the flags must be on
 # the interface so that any consumer compiling NFG headers gets them too.
+# MSVC spells all of these differently: it has no -frounding-math (the
+# equivalent is /fp:strict, without which the compiler may reorder FP ops and
+# ignore the dynamic rounding mode that interval_number depends on), and no
+# separate FMA flag (/arch:AVX2 is the only way to get it). Passing the
+# GCC/Clang spellings there is not merely useless -- cl warns D9002 and drops
+# them, leaving the interval arithmetic without its rounding guarantee.
+if(MSVC)
+	target_compile_options(nfg_iface INTERFACE /fp:strict)
+	if(TIGHT_SIMD STREQUAL "AVX2")
+		target_compile_options(nfg_iface INTERFACE /arch:AVX2)
+	elseif(TIGHT_SIMD STREQUAL "ARMNEON")
+		CPMAddPackage("gh:simd-everywhere/simde#master")
+		target_include_directories(nfg_iface INTERFACE "${simde_SOURCE_DIR}/simde")
+	elseif(NOT TIGHT_SIMD STREQUAL "SSE2" AND NOT TIGHT_SIMD STREQUAL "NONE")
+		message(FATAL_ERROR "Unknown TIGHT_SIMD value: ${TIGHT_SIMD}")
+	endif()
+else()
 target_compile_options(nfg_iface INTERFACE -frounding-math)
 if(TIGHT_SIMD STREQUAL "AVX2")
 	target_compile_options(nfg_iface INTERFACE -mavx2 -mfma)
@@ -30,3 +47,4 @@
 elseif(NOT TIGHT_SIMD STREQUAL "NONE")
 	message(FATAL_ERROR "Unknown TIGHT_SIMD value: ${TIGHT_SIMD}")
 endif()
+endif()
